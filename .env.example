# Copy to .env and adjust. `make` loads .env automatically when present.

# --- Postgres (used by docker-compose and by the API) ---
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit
POSTGRES_PORT=5432

# --- API ---
# Consumed by cmd/api/main.go and by goose (make migrate-*).
DATABASE_URL=postgres://conduit:conduit@localhost:5432/conduit?sslmode=disable
PORT=8080

# --- Secrets (M2) ---
# Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-do-not-use-in-production

# --- Frontend ---
# Vite proxies /api to this in dev; see web/vite.config.ts
VITE_API_PROXY_TARGET=http://localhost:8080
